# ─────────────────────────────────────────────────────────────
# Supabase (public, safe for browser)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth is configured in the Supabase dashboard,
# not in this app's environment. Provider callback URL:
# https://ghcctymglxgaxysdfvqi.supabase.co/auth/v1/callback

# Supabase service role — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the running app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Buy Me a Coffee — server-only webhook secret and public creator page URL
BUYMEACOFFEE_PAGE_URL=https://buymeacoffee.com/your-page
BUYMEACOFFEE_WEBHOOK_SECRET=your-webhook-signing-secret

# Sentry browser/server DSN (safe to expose; create this in Sentry)
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# Optional source-map upload settings for production builds
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
